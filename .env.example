# Chaque jeu copie ce fichier en `.env`. Une variable vide vaut absente.
# Tout est validé au démarrage : une valeur invalide arrête le serveur avec
# un message qui dit laquelle et pourquoi.

# ─── Chat ───────────────────────────────────────────────────────────────────
# Chaîne lue. Vide → seul le simulateur démarre (npm run simu).
TWITCH_CHANNEL=

# Compte bot qui répond. Vides → lecture anonyme : le jeu reste jouable,
# seules les annonces manquent. Scopes du jeton : chat:read + chat:edit.
TWITCH_BOT_TOKEN=
TWITCH_BOT_USERNAME=

# Langue des réponses du bot : fr ou en. Les commandes marchent dans les deux.
LANGUE=fr

# Comptes ignorés, séparés par des virgules, EN PLUS de nightbot,
# streamelements, streamlabs, moobot, fossabot, wizebot, soundalerts.
BOTS_IGNORES=

# ─── Serveur ────────────────────────────────────────────────────────────────
# Le SNCF garde 3000.
PORT=3001
# Autre valeur que 127.0.0.1 / localhost → PANEL_TOKEN obligatoire.
HOST=127.0.0.1
# Mot de passe du panneau, au moins 32 caractères (Authorization: Bearer …).
PANEL_TOKEN=
# Hôtes acceptés en plus de localhost / 127.0.0.1 / [::1], séparés par des virgules.
HOTES_AUTORISES=

# ─── Données ────────────────────────────────────────────────────────────────
# Vide → data/<jeu>.db
DB_PATH=
# Joueurs sans participation depuis ce nombre de mois : effacés au démarrage.
PURGE_MOIS=12
