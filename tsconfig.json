{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    // Les modules du studio sont du JavaScript de navigateur, sans types. Les
    // tests doivent pouvoir les importer pour vérifier autre chose que leur
    // syntaxe ; `checkJs` reste absent, donc `tsc` les résout sans prétendre
    // les typer.
    "allowJs": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "tests"]
}
